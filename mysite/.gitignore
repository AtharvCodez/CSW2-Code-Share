# -------------------------------
# Python cache files
# -------------------------------
__pycache__/
*.py[cod]          # covers .pyc, .pyo, .pyd (REMOVED duplicate *.pyc)
*$py.class

# -------------------------------
# Virtual environment
# -------------------------------
env/
venv/
.venv/

# -------------------------------
# Environment variables (secrets)
# -------------------------------
.env

# -------------------------------
# Django specific
# -------------------------------
db.sqlite3         # local database (don’t push)
*.log

# -------------------------------
# Static files (only if using collectstatic)
# -------------------------------
staticfiles/       # used when STATIC_ROOT is set

# -------------------------------
# Media uploads (user content)
# -------------------------------
media/

# -------------------------------
# IDE / Editor files
# -------------------------------
.vscode/
.idea/             # ✅ ADDED (for PyCharm users)

# -------------------------------
# OS junk files
# -------------------------------
.DS_Store
Thumbs.db

# -------------------------------
# Python build / packaging files
# -------------------------------
build/
dist/
*.egg-info/

# -------------------------------
# Jupyter notebooks
# -------------------------------
.ipynb_checkpoints/